// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  nickname       String?
  accounts       Account[]
  sessions       Session[]
  participations Participant[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id             String          @id @default(cuid())
  title          String
  destination    String
  startDate      String          @default("")
  endDate        String          @default("")
  // 日程調整：旅行の日数と、行ける日を聞く期間（作成時に決める）
  days           Int?
  rangeStart     String?
  rangeEnd       String?
  // 作成者が仮決定した日程の開始日。全員が ○ と答えると startDate・endDate に確定する
  tentativeStart String?
  createdAt      DateTime        @default(now())
  participants   Participant[]
  payments       Payment[]
  itineraryItems ItineraryItem[]
}

model Participant {
  id                    String         @id @default(cuid())
  name                  String
  projectId             String
  project               Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // プロジェクトを作った人（日程の仮決定や、メンバーを外すことができる）
  isOwner               Boolean        @default(false)
  // ゲストの復帰用コード。元に戻せない形（SHA-256）で保存する。Googleでログインした人は null
  guestCodeHash         String?        @unique
  payments              Payment[]
  availableDays         AvailableDay[]
  // 行ける日を提出したか（全員が提出すると、作成者が日程を仮決定できる）
  availabilitySubmitted Boolean        @default(false)
  // 仮決定の日程への答え。"yes"（○）・"no"（×）・null（まだ）
  tentativeAnswer       String?

  @@unique([projectId, userId])
}

// メンバーが「行ける」と付けた日（日付は "YYYY-MM-DD"）
model AvailableDay {
  id            String      @id @default(cuid())
  date          String
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, date])
}

model Payment {
  id        String      @id @default(cuid())
  payerId   String
  // 支払いが残っている参加者は消せないようにする（メンバーを外したときに支払い記録まで消えないように）
  payer     Participant @relation(fields: [payerId], references: [id], onDelete: NoAction)
  memo      String
  amount    Int
  createdAt DateTime    @default(now())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// 旅行の予定（日ごとのメモ）。日付ではなく「何日目か」で持つので、日程を決め直しても予定は残る
model ItineraryItem {
  id        String   @id @default(cuid())
  dayIndex  Int
  time      String   @default("")
  text      String
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ゲストの復帰用コードの入力ミス。短い時間に何度も間違えた端末からの入力を止めるために使う
model GuestCodeAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
