// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  nickname       String?
  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  participations Participant[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id           String              @id @default(cuid())
  title        String
  destination  String
  startDate    String              @default("")
  endDate      String              @default("")
  // 日程調整：旅行の日数と、行けない日を聞く期間（作成者が日程調整の画面で決める）
  days         Int?
  rangeStart   String?
  rangeEnd     String?
  createdAt    DateTime            @default(now())
  ownerId      String
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants Participant[]
  payments     Payment[]
  candidates   ScheduleCandidate[]
}

model Participant {
  id              String           @id @default(cuid())
  name            String
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        Payment[]
  unavailableDays UnavailableDay[]
  votes           ScheduleVote[]

  @@unique([projectId, userId])
}

// メンバーが「行けない」と付けた日（日付は "YYYY-MM-DD"）
model UnavailableDay {
  id            String      @id @default(cuid())
  date          String
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, date])
}

// 作成者が選んだ日程の候補（開始日。終了日は旅行の日数から決まる）
model ScheduleCandidate {
  id        String         @id @default(cuid())
  startDate String
  createdAt DateTime       @default(now())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  votes     ScheduleVote[]

  @@unique([projectId, startDate])
}

// 候補への投票。answer は "yes"（○）・"maybe"（△）・"no"（×）
model ScheduleVote {
  id            String            @id @default(cuid())
  answer        String
  candidateId   String
  candidate     ScheduleCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([candidateId, participantId])
}

model Payment {
  id        String      @id @default(cuid())
  payerId   String
  // 支払いが残っている参加者は消せないようにする（メンバーを外したときに支払い記録まで消えないように）
  payer     Participant @relation(fields: [payerId], references: [id], onDelete: NoAction)
  memo      String
  amount    Int
  isSettled Boolean     @default(false)
  createdAt DateTime    @default(now())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
